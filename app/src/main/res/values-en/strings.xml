    <!-- Per-meditation localized content (subtitles, about, how-to) -->
    <string name="meditation_subtitle_mindfulness_basics">Short presence practice</string>
    <string name="meditation_about_mindfulness_basics">Basic mindfulness: gently observe your breath and sensations. Let thoughts pass without involvement.</string>
    <string name="meditation_howto_mindfulness_basics">1) Sit comfortably. 2) Feel your breath. 3) Notice distractions and gently return to the breath. 4) Practice 5–10 minutes daily.</string>

    <string name="meditation_subtitle_deep_breathing">Calming through breath</string>
    <string name="meditation_about_deep_breathing">Deep, even breathing relaxes body and mind, reduces tension and stabilizes emotions.</string>
    <string name="meditation_howto_deep_breathing">1) Inhale through the nose for 4 counts. 2) Exhale through the nose for 4–6 counts. 3) Breathe softly, without effort. 4) Observe sensations.</string>

    <string name="meditation_subtitle_body_scan">Step-by-step body relaxation</string>
    <string name="meditation_about_body_scan">Body scan builds sensitivity and relieves muscular tension.</string>
    <string name="meditation_howto_body_scan">1) Move attention from crown to toes. 2) Notice tension. 3) Relax areas on the exhale. 4) Avoid evaluation.</string>

