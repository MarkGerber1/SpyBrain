    <!-- Voice Prompts for Breathing Patterns -->
    <string name="voice_prompt_calm">Breathe calmly and deeply. Inhale through your nose, exhale through your mouth.</string>
    <string name="voice_prompt_box">Imagine a square. Inhale for 4 counts, hold for 4, exhale for 4, hold for 4.</string>
    <string name="voice_prompt_sleep">Inhale for 4 counts, hold your breath for 7, exhale for 8 counts.</string>
    <string name="voice_prompt_lion">Take a deep breath, then exhale with an open mouth and tongue out, making a \'ha\' sound.</string>
    <string name="voice_prompt_bee">Cover your ears with your fingers, inhale deeply, make a buzzing sound on exhale.</string>
    <string name="voice_prompt_fire">Quick and rhythmic inhales and exhales through the nose, as if breathing fire.</string>
    <string name="voice_prompt_evening">Breathe slowly and deeply, imagining tension leaving with each exhale.</string>
    <string name="voice_prompt_clarity">Focus on your breathing. Inhale clarity, exhale distractions.</string>
    <string name="voice_prompt_morning">Inhale energy and vitality, exhale fatigue and weakness.</string>
    <string name="voice_prompt_creative">Inhale inspiration, exhale doubts. Open the flow of creativity.</string>
    
